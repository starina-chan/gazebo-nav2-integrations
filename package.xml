<?xml version="1.0"?>
<package format="2">
  <name>gazebo_nav2_integrations</name>
  <version>0.0.0</version>
  <description>Mirrors Nav2 map/pose state into Gazebo Classic (map -> mesh + spawned model, initialpose -> entity teleport)</description>

  <maintainer email="peeravatanachartnol@firstloop-tech.com">devrobot</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>python3-opencv</depend>
  <depend>python3-numpy</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
